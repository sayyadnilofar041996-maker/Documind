# ============================================================
# DocuMind — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. Get free Groq API key at: console.groq.com
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=DocuMind
APP_VERSION=1.0.0
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-64-char-hex-string

# ── PostgreSQL Database ───────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://documind_user:replace-with-strong-password@postgres:5432/documind

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Groq API (free at console.groq.com) ──────────────────────
GROQ_API_KEY=gsk_replace-with-your-groq-api-key
GROQ_MODEL=llama3-8b-8192
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.1

# ── HuggingFace Embeddings (runs locally on CPU) ─────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/app/.cache/huggingface

# ── JWT Authentication ────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,py,js,ts,md

# ── RAG Pipeline ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.4
CONVERSATION_HISTORY_PAIRS=6

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Celery Workers ────────────────────────────────────────────
# Keep at 2 for AMD Ryzen 5 4500U with 8GB RAM
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ── MCP Server ───────────────────────────────────────────────
# Internal service key — generate same way as SECRET_KEY
MCP_API_KEY=replace-with-another-random-hex-string