APP_NAME=DocuMind
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-64-char-random-hex

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_pass
DATABASE_URL=postgresql+asyncpg://documind_user:documind_pass@postgres:5432/documind

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-8b-8192
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.1

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/app/.cache/huggingface

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,py,js,ts,md

CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.4
CONVERSATION_HISTORY_PAIRS=6

CELERY_WORKER_CONCURRENCY=2